#!/usr/bin/env bash
# Mistbar Launcher and Manager

set -euo pipefail

SCRIPT_SOURCE="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"
BUILD_BIN_DIR="$SCRIPT_DIR/build"
LOCAL_BIN_DIR="$HOME/.local/bin"
CONFIG_DIR="$HOME/.config/mistbar"
CONFIG_FILE="$CONFIG_DIR/config.json"
SOCK_PATH="${XDG_RUNTIME_DIR:-/tmp/mistbar-$(id -u)}/mistbar/bar.sock"

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m'

find_bin() {
    local name="$1"
    if [ -x "$BUILD_BIN_DIR/$name" ]; then
        echo "$BUILD_BIN_DIR/$name"
    elif [ -x "$LOCAL_BIN_DIR/$name" ]; then
        echo "$LOCAL_BIN_DIR/$name"
    elif command -v "$name" &>/dev/null; then
        command -v "$name"
    else
        echo ""
    fi
}

send_ipc() {
    local cmd="$1"
    python3 -c "
import socket, sys
sock_path = '$SOCK_PATH'
cmd = sys.argv[1]
try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(1.0)
    s.connect(sock_path)
    s.sendall((cmd + '\n').encode())
    data = s.recv(4096).decode().strip()
    s.close()
    print(data)
    sys.exit(0)
except Exception:
    sys.exit(1)
" "$cmd" 2>/dev/null
}

is_running() {
    pgrep -x "mistbar-daemon" >/dev/null 2>&1 && [ -S "$SOCK_PATH" ]
}

print_help() {
    echo -e "${CYAN}${BOLD}Mistbar v0.3.0 - Native macOS Liquid Glass Bar${NC}"
    echo ""
    echo "USAGE:"
    echo "    mistbar                  Open Mistbar Settings desktop app"
    echo "    mistbar <command>        Control the Mistbar bar service"
    echo ""
    echo "COMMANDS:"
    echo -e "    ${GREEN}settings [page]${NC}          Open Mistbar Settings desktop app"
    echo -e "    ${GREEN}start${NC}                    Start the top bar daemon"
    echo -e "    ${GREEN}stop${NC}                     Stop the top bar daemon"
    echo -e "    ${GREEN}restart${NC}                  Restart the top bar daemon"
    echo -e "    ${GREEN}status${NC}                   Show daemon and shader status"
    echo -e "    ${GREEN}tuner${NC}                    Open the live Liquid Glass Shader Lab"
    echo -e "    ${GREEN}cc${NC}                       Toggle the Liquid Glass Control Center"
    echo -e "    ${GREEN}spotlight${NC}                Open the Liquid Glass Spotlight search pill"
    echo -e "    ${GREEN}toggle${NC}                   Toggle intelligent auto-hide"
    echo -e "    ${GREEN}show${NC}                     Show bar (always visible)"
    echo -e "    ${GREEN}hide${NC}                     Hide bar completely"
    echo -e "    ${GREEN}auto-hide <on|off|toggle>${NC} Configure intelligent auto-hide"
    echo -e "    ${GREEN}theme <dark|light>${NC}       Switch theme"
    echo -e "    ${GREEN}preset <clear|frosted|smoked|aqua|solid>${NC} Switch Liquid Glass preset"
    echo -e "    ${GREEN}look <attached|pill>${NC}     Switch bar geometry"
    echo -e "    ${GREEN}config${NC}                   Print or edit config.json"
    echo -e "    ${GREEN}build${NC}                    Build Mistbar with CMake"
    echo -e "    ${GREEN}install-deps${NC}             Install required system dependencies"
    echo -e "    ${GREEN}update${NC}                   Update Mistbar to latest release or main"
    echo -e "    ${GREEN}uninstall${NC}                Uninstall Mistbar"
    echo -e "    ${GREEN}-h, --help${NC}               Show this help"
    echo -e "    ${GREEN}-v, --version${NC}            Show version"
}

cmd_build() {
    echo -e "${BLUE}Building Mistbar (C++20 / GLSL)...${NC}"
    cmake -S "$SCRIPT_DIR" -B "$BUILD_BIN_DIR" -DCMAKE_BUILD_TYPE=Release
    cmake --build "$BUILD_BIN_DIR" -j
    echo -e "${GREEN}Build complete.${NC}"
}

cmd_settings() {
    local page="${1:-}"
    local bin
    bin="$(find_bin mistbar-settings)"
    if [ -z "$bin" ]; then
        cmd_build
        bin="$(find_bin mistbar-settings)"
    fi
    if [ -z "$bin" ]; then
        echo -e "${RED}Error: mistbar-settings binary not found.${NC}"
        exit 1
    fi
    if [ -n "$page" ]; then
        setsid -f "$bin" --page "$page" >/dev/null 2>&1
    else
        setsid -f "$bin" >/dev/null 2>&1
    fi
}

cmd_start() {
    if is_running; then
        echo -e "${BLUE}Mistbar is already running.${NC}"
        return 0
    fi
    local bin
    bin="$(find_bin mistbar-daemon)"
    if [ -z "$bin" ]; then
        cmd_build
        bin="$(find_bin mistbar-daemon)"
    fi
    if [ -z "$bin" ]; then
        echo -e "${RED}Error: mistbar-daemon binary not found.${NC}"
        return 1
    fi

    mkdir -p "$CONFIG_DIR"
    local log_file="$CONFIG_DIR/mistbar.log"
    setsid -f "$bin" >"$log_file" 2>&1

    local count=0
    while [ $count -lt 30 ]; do
        if is_running; then
            echo -e "${GREEN}Mistbar started successfully.${NC}"
            return 0
        fi
        sleep 0.1
        count=$((count + 1))
    done
    echo -e "${RED}Failed to verify Mistbar startup.${NC}"
    return 1
}

cmd_stop() {
    if is_running; then
        send_ipc "quit" >/dev/null || true
        local count=0
        while pgrep -x "mistbar-daemon" >/dev/null 2>&1 && [ $count -lt 15 ]; do
            sleep 0.1
            count=$((count + 1))
        done
    fi
    pkill -x "mistbar-daemon" 2>/dev/null || true
    echo -e "${GREEN}Mistbar stopped.${NC}"
}

cmd_ipc_or_fail() {
    local req="$1"
    if ! is_running; then
        echo -e "${RED}Mistbar is not running. Start it with 'mistbar start'.${NC}"
        return 1
    fi
    local out
    out="$(send_ipc "$req" || echo "error")"
    echo -e "${GREEN}$out${NC}"
}

cmd_install_deps() {
    if command -v pacman &>/dev/null; then
        echo -e "${BLUE}Installing dependencies via pacman...${NC}"
        sudo pacman -S --needed --noconfirm \
            cmake ninja gcc pkgconf wayland wayland-protocols \
            libxkbcommon cairo pango gdk-pixbuf2 librsvg dbus \
            mesa libglvnd brightnessctl networkmanager bluez-utils wireplumber \
            2>/dev/null || true
        echo -e "${GREEN}Dependencies installed.${NC}"
    else
        echo -e "${RED}Unsupported package manager.${NC}"
        echo "Required: cmake, wayland, wayland-protocols, libxkbcommon, cairo, pango, gdk-pixbuf-2.0, librsvg-2.0, dbus-1, wayland-egl"
    fi
}

case "${1:-}" in
    "")
        cmd_settings
        ;;
    settings|app|gui)
        shift
        cmd_settings "${1:-}"
        ;;
    build)
        cmd_build
        ;;
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    restart)
        cmd_stop
        sleep 0.2
        cmd_start
        ;;
    status)
        if is_running; then
            echo -e "${GREEN}Mistbar is $(send_ipc status)${NC}"
        else
            echo -e "${RED}Mistbar is not running${NC}"
        fi
        ;;
    toggle)
        if ! is_running; then cmd_start; else cmd_ipc_or_fail "toggle"; fi
        ;;
    show)
        if ! is_running; then cmd_start; else cmd_ipc_or_fail "show"; fi
        ;;
    hide)
        cmd_ipc_or_fail "hide"
        ;;
    --auto-hide|autohide|auto-hide)
        shift || true
        cmd_ipc_or_fail "autohide:${1:-toggle}"
        ;;
    --always-visible)
        cmd_ipc_or_fail "autohide:off"
        ;;
    theme)
        shift
        cmd_ipc_or_fail "theme:${1:-dark}"
        ;;
    preset|style)
        shift
        if [ -n "${2:-}" ]; then
            cmd_ipc_or_fail "preset:${1:-regular}:$2"
        else
            cmd_ipc_or_fail "preset:${1:-regular}"
        fi
        ;;
    look)
        shift
        cmd_ipc_or_fail "look:${1:-attached}"
        ;;
    tuner)
        cmd_ipc_or_fail "tuner"
        ;;
    cc|control-center)
        cmd_ipc_or_fail "cc"
        ;;
    spotlight)
        cmd_ipc_or_fail "spotlight"
        ;;
    config)
        if [ -n "${EDITOR:-}" ] && [ -f "$CONFIG_FILE" ]; then
            "$EDITOR" "$CONFIG_FILE"
        elif [ -f "$CONFIG_FILE" ]; then
            cat "$CONFIG_FILE"
        else
            echo "No config file yet at $CONFIG_FILE"
        fi
        ;;
    install-deps)
        cmd_install_deps
        ;;
    update)
        shift
        if [ -f "$SCRIPT_DIR/update.sh" ]; then
            exec bash "$SCRIPT_DIR/update.sh" "$@"
        elif [ -f "$SCRIPT_DIR/install.sh" ]; then
            exec bash "$SCRIPT_DIR/install.sh" "$@"
        elif [ -f "$HOME/.mistbar/update.sh" ]; then
            exec bash "$HOME/.mistbar/update.sh" "$@"
        else
            exec bash -c "$(curl -fsSL https://raw.githubusercontent.com/TattvaOrg/Mistbar/main/update.sh)" -- "$@"
        fi
        ;;
    uninstall)
        shift
        if [ -f "$SCRIPT_DIR/uninstall.sh" ]; then
            exec bash "$SCRIPT_DIR/uninstall.sh" "$@"
        elif [ -f "$HOME/.mistbar/uninstall.sh" ]; then
            exec bash "$HOME/.mistbar/uninstall.sh" "$@"
        else
            echo -e "${RED}Error: Uninstall script not found.${NC}"
            exit 1
        fi
        ;;
    -v|--version)
        echo "Mistbar v0.3.0"
        ;;
    -h|--help)
        print_help
        ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}"
        echo "Run 'mistbar --help' for usage."
        exit 1
        ;;
esac
